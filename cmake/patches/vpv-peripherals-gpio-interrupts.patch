@@ -37,6 +38,9 @@ gpio::gpio(sc_core::sc_module_name nm)
     SC_METHOD(reset_cb);
     sensitive << rst_i;
     dont_initialize();
+    SC_METHOD(update_irq);
+    sensitive << irq_evt;
+    dont_initialize();
     auto pins_i_cb = [this](unsigned int tag, tlm::scc::tlm_signal_gp<sc_logic>& gp, tlm::tlm_phase& phase,
                             sc_core::sc_time& delay) -> tlm::tlm_sync_enum {
         this->pin_input(tag, gp, delay);
@@ -88,6 +92,52 @@ gpio::gpio(sc_core::sc_module_name nm)
         update_inputs();
         return true;
     });
+    auto enable_cb = [this](scc::sc_register<uint32_t>& reg, uint32_t data, sc_core::sc_time d) -> bool {
+        reg.put(data);
+        irq_evt.notify(sc_core::SC_ZERO_TIME);
+        return true;
+    };
+    regs->rise_ie.set_write_cb(enable_cb);
+    regs->fall_ie.set_write_cb(enable_cb);
+    regs->high_ie.set_write_cb(enable_cb);
+    regs->low_ie.set_write_cb(enable_cb);
+    // A pending bit is cleared by writing a one to it.
+    auto clear_cb = [this](scc::sc_register<uint32_t>& reg, uint32_t data, sc_core::sc_time d) -> bool {
+        reg.put(reg.get() & ~data);
+        irq_evt.notify(sc_core::SC_ZERO_TIME);
+        return true;
+    };
+    regs->rise_ip.set_write_cb(clear_cb);
+    regs->fall_ip.set_write_cb(clear_cb);
+    regs->high_ip.set_write_cb(clear_cb);
+    regs->low_ip.set_write_cb(clear_cb);
+    // A level is pending while a pin is at it, whatever has been cleared.
+    regs->high_ip.set_read_cb([this](const scc::sc_register<uint32_t>& reg, uint32_t& data, sc_core::sc_time d) -> bool {
+        data = reg.get() | regs->r_value;
+        return true;
+    });
+    regs->low_ip.set_read_cb([this](const scc::sc_register<uint32_t>& reg, uint32_t& data, sc_core::sc_time d) -> bool {
+        data = reg.get() | ~regs->r_value;
+        return true;
+    });
+}
+
+void gpio::pend_events(uint32_t before, uint32_t changed) {
+    regs->r_rise_ip |= changed & ~before;
+    regs->r_fall_ip |= changed & before;
+    regs->r_high_ip |= changed & before;
+    regs->r_low_ip |= changed & ~before;
+    irq_evt.notify(sc_core::SC_ZERO_TIME);
+}
+
+void gpio::update_irq() {
+    auto high = regs->r_high_ip | regs->r_value;
+    auto low = regs->r_low_ip | ~regs->r_value;
+    auto pending = (regs->r_rise_ie & regs->r_rise_ip) | (regs->r_fall_ie & regs->r_fall_ip) |
+                   (regs->r_high_ie & high) | (regs->r_low_ie & low);
+    for(size_t i = 0; i < irq_o.size(); ++i)
+        if(irq_o[i].get_interface())
+            irq_o[i].write((pending >> i) & 1);
 }
 
 // What each input pin reads: what is driven on it from outside, or with
@@ -95,7 +145,9 @@ gpio::gpio(sc_core::sc_module_name nm)
 void gpio::update_inputs() {
     auto inputs = ~regs->r_output_en;
     auto outside = (driven_high & driven) | (regs->r_pue & ~driven);
+    auto before = regs->r_value;
     regs->r_value = (regs->r_value & ~inputs) | (outside & inputs);
+    pend_events(before, before ^ regs->r_value);
 }
 
 gpio::~gpio() = default;
