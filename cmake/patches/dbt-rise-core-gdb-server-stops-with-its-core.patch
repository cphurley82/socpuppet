+    /**
+     * stop the server started for the given core, if any: it no longer listens or answers, and nothing of it reaches
+     * the core again, so the core may go. The server itself is left, as it always was: a session's command handler shares the
+     * core's target adapter, which the core deletes itself.
+     *
+     * Its thread is waited for, unless it is waiting for the simulation's thread: a debugger's memory access, run or
+     * step is seen to there, and is never seen to once the core is going. A thread that waits so touches nothing but
+     * the server, and is left waiting. (shutdown() lets the io_context run out of work and waits for the thread, which
+     * a pending accept keeps from ever happening.)
+     * @param vm the core being debugged
+     */
+    static void stop(iss::debugger_if* vm) {
+        auto* srv = get(vm);
+        if(srv == NULL)
+            return;
+        srv->io_service.stop();
+        // Anything else the thread may be doing is over in a moment.
+        auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+        while(srv->serving.load() && std::chrono::steady_clock::now() < deadline)
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        if(!srv->serving.load())
+            srv->threads.join_all();
+        // The port is free for another. The thread is done with the accept, or waits elsewhere for ever.
+        boost::system::error_code ignored;
+        srv->acceptor.close(ignored);
+    }
+
