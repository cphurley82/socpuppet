diff --git a/qemu-components/common/include/cpu.h b/qemu-components/common/include/cpu.h
--- a/qemu-components/common/include/cpu.h
+++ b/qemu-components/common/include/cpu.h
@@ -151,6 +151,36 @@
     gs::runonsysc m_on_sysc;
     std::shared_ptr<qemu::Timer> m_deadline_timer;
     bool m_coroutines;
+    /*
+     * How far the virtual clock lags SystemC's, in ns, after the waits for
+     * work. With icount and sleep off, the virtual clock counts instructions
+     * and stands still while the CPU waits for work, as SystemC's clock moves
+     * on: so as a coroutine, each wait leaves it further behind
+     * (catch_up_after_wait).
+     */
+    int64_t m_vclock_lag_ns = 0;
+
+    /*
+     * The CPU's time, in ns: the virtual clock plus the time it lags SystemC's
+     * by after waits for work. The CPU's lead over SystemC's clock is worked
+     * out from this.
+     */
+    int64_t cpu_time_ns() { return m_inst.get().get_virtual_clock() + m_vclock_lag_ns; }
+
+    /*
+     * After a wait for work, the CPU's time is SystemC's at least: what it
+     * does next takes the clock's time from there. Without this, it works
+     * with no lead over SystemC's clock until the virtual clock has counted
+     * up to the time it waited, and the clock stands still meanwhile. The lag
+     * only grows: the CPU's time never goes back, and a CPU still ahead of
+     * SystemC's clock when it wakes keeps its lead.
+     */
+    void catch_up_after_wait()
+    {
+        const int64_t now_ns = int64_t(sc_core::sc_time_stamp().to_seconds() * 1e9);
+        const int64_t lag = now_ns - m_inst.get().get_virtual_clock();
+        if (lag > m_vclock_lag_ns) m_vclock_lag_ns = lag;
+    }
 
     qemu::Cpu m_cpu;
     std::string m_cpu_type;
@@ -336,7 +366,7 @@
             rearm_deadline_timer();
 
             /* Take this opportunity to set the time */
-            int64_t now = m_inst.get().get_virtual_clock();
+            int64_t now = cpu_time_ns();
             sc_core::sc_time sc_t = sc_core::sc_time_stamp();
             if (sc_core::sc_time(now, sc_core::SC_NS) > sc_t) {
                 m_qk->set(sc_core::sc_time(now, sc_core::SC_NS) - sc_t);
@@ -361,6 +391,7 @@
 
         if (m_coroutines) {
             m_on_sysc.run_on_sysc([this]() { wait(m_external_ev); });
+            catch_up_after_wait();
         } else {
             if (m_inst.get_tcg_mode() != QemuInstance::TCG_SINGLE) {
                 std::unique_lock<std::mutex> lock(m_signaled_lock);
@@ -479,7 +510,7 @@
      */
     void sync_with_kernel()
     {
-        int64_t now = m_inst.get().get_virtual_clock();
+        int64_t now = cpu_time_ns();
 
         m_cpu.set_soft_stopped(true);
 
@@ -849,7 +880,7 @@
     {
         if (m_finished) return sc_core::SC_ZERO_TIME;
 
-        int64_t vclock_now = m_inst.get().get_virtual_clock();
+        int64_t vclock_now = cpu_time_ns();
         sc_core::sc_time sc_t = sc_core::sc_time_stamp();
         return m_time_sync->get_local_time(vclock_now, sc_t);
     }
