+template <typename BASE, features_e FEAT> iss::status riscv_hart_msu_vp<BASE, FEAT>::read_topi(unsigned addr, reg_t& val) {
+    // the highest-priority interrupt that is pending and enabled and is this mode's to take: of those mideleg keeps for
+    // mtopi, and of those it hands down for stopi. Its number is in bits 27 to 16, and the priority below it may always be 1,
+    // since no interrupt's priority can be configured here. The order is the AIA's default: the machine's external, software
+    // and timer interrupts, then the supervisor's
+    const uint64_t delegated = this->csr[mideleg];
+    const uint64_t candidates = this->mip_csr & this->mie_csr & (addr == mtopi ? ~delegated : delegated);
+    val = 0;
+    for(const unsigned irq : {11u, 3u, 7u, 9u, 1u, 5u})
+        if(candidates & (1ULL << irq)) {
+            val = (reg_t(irq) << 16) | 1;
+            break;
+        }
+    return iss::Ok;
+}
