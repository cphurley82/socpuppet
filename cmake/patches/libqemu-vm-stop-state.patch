diff --git a/libqemu/wrappers/gdbserver.c b/libqemu/wrappers/gdbserver.c
index 27ea786a6..620d8e2ff 100644
--- a/libqemu/wrappers/gdbserver.c
+++ b/libqemu/wrappers/gdbserver.c
@@ -22,6 +22,40 @@
 #include "gdbserver.h"
 #include "qapi/error.h"
 #include "qemu/error-report.h"
+#include "hw/core/cpu.h"
+#include "system/runstate.h"
+
+/* How many times the machine has stopped since the GDB server came up. */
+static uint64_t stops;
+
+/*
+ * Once the GDB server is up, every stop of the machine is told to every
+ * vCPU, as a continue is, so that the platform hears of it even from a vCPU
+ * that is asleep. And each is counted: a vCPU that only looks after its
+ * kick can find the machine running again, and the count says it stopped
+ * meanwhile.
+ */
+static void kick_on_stop(void *opaque, bool running, RunState state)
+{
+    CPUState *cpu;
+
+    if (running) {
+        return;
+    }
+    stops++;
+    CPU_FOREACH(cpu) {
+        qemu_cpu_kick(cpu);
+    }
+}
+
+/*
+ * How many times the machine has stopped since the GDB server came up.
+ * Call it with the BQL held, as the count is changed with it held.
+ */
+uint64_t libqemu_vm_stop_count(void)
+{
+    return stops;
+}
 
 void libqemu_gdbserver_start(const char *port_or_path)
 {
@@ -32,4 +66,5 @@ void libqemu_gdbserver_start(const char *port_or_path)
         error_free(err);
         exit(1);
     }
+    qemu_add_vm_change_state_handler(kick_on_stop, NULL);
 }
