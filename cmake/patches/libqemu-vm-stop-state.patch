     return r;
 }
 
+/*
+ * Whether a stop has been asked for that the main loop has yet to make:
+ * a vCPU's at a breakpoint, or another of a vCPU's own.
+ */
+bool qemu_vm_stop_pending(void)
+{
+    bool pending;
+
+    qemu_mutex_lock(&vmstop_lock);
+    pending = vmstop_requested != RUN_STATE__MAX;
+    qemu_mutex_unlock(&vmstop_lock);
+    return pending || debug_requested;
+}
