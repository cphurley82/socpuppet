+/*
+ * Whether the machine is stopped, or is about to be: a vCPU that stops at a
+ * breakpoint asks the main loop to stop the machine, and until it has, the
+ * machine still runs. Call it with the BQL held.
+ */
+bool libqemu_vm_is_stopped(void)
+{
+    return !runstate_is_running() || qemu_vm_stop_pending();
+}
+
+/*
+ * Whether the vCPU is stopped, or has a stop to take: a run of it then runs
+ * no instruction. Call it with the BQL held.
+ */
+bool libqemu_cpu_is_stopped(Object *obj)
+{
+    CPUState *cpu = CPU(obj);
+
+    return cpu->stop || cpu->stopped;
+}
+
 void libqemu_cpu_set_vcpu_dirty(Object *obj, bool dirty)
 {
     CPU(obj)->vcpu_dirty = dirty;
