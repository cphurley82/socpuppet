+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "qemu/osdep.h"
+#include "ui/console.h"
+#include "ui/sdl2.h"
+
+bool console_gl_check_format(DisplayChangeListener *dcl,
+                             pixman_format_code_t format);
+
+bool console_gl_check_format(DisplayChangeListener *dcl,
+                             pixman_format_code_t format)
+{
+    return false;
+}
+
+void sdl2_gl_update(DisplayChangeListener *dcl, int x, int y, int w, int h)
+{
+    g_assert_not_reached();
+}
+
+void sdl2_gl_switch(DisplayChangeListener *dcl, DisplaySurface *new_surface)
+{
+    g_assert_not_reached();
+}
+
+void sdl2_gl_refresh(DisplayChangeListener *dcl)
+{
+    g_assert_not_reached();
+}
+
+QEMUGLContext sdl2_gl_create_context(DisplayGLCtx *dgc, QEMUGLParams *params)
+{
+    g_assert_not_reached();
+}
+
+void sdl2_gl_destroy_context(DisplayGLCtx *dgc, QEMUGLContext ctx)
+{
+    g_assert_not_reached();
+}
+
+int sdl2_gl_make_context_current(DisplayGLCtx *dgc, QEMUGLContext ctx)
+{
+    g_assert_not_reached();
+}
+
+void sdl2_gl_scanout_disable(DisplayChangeListener *dcl)
+{
+    g_assert_not_reached();
+}
+
+void sdl2_gl_scanout_texture(DisplayChangeListener *dcl,
+                             uint32_t backing_id,
+                             bool backing_y_0_top,
+                             uint32_t backing_width,
+                             uint32_t backing_height,
+                             uint32_t x, uint32_t y,
+                             uint32_t w, uint32_t h,
+                             void *d3d_tex2d)
+{
+    g_assert_not_reached();
+}
+
+void sdl2_gl_scanout_flush(DisplayChangeListener *dcl,
+                           uint32_t x, uint32_t y, uint32_t w, uint32_t h)
+{
+    g_assert_not_reached();
+}
