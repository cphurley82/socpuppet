+// in MSI delivery mode an interrupt that is pending and enabled is forwarded as an MSI, and its pending bit is
+// cleared. The MSIs are sent by a thread of the model's own: whoever is on the way to the hart may wait, and this
+// is reached from a method when a wire changes and from the caller's thread when a register is written.
+void aplic::forward_pending_by_msi() {
+    if(regs->r_domaincfg.interruptenable != 1) {
+        return;
+    }
+    for(size_t irq = 1; irq < external_global_interrupts_i.size(); irq++) {
+        auto reg_idx = get_reg_index(irq);
+        auto bit_ofs = get_bit_pos(irq);
+        auto pending = (regs->r_pending[reg_idx] & (0x1 << bit_ofs)) ? true : false;
+        auto enable = (regs->r_enabled[reg_idx] & (0x1 << bit_ofs)) ? true : false;
+        if(enable && pending) {
+            SCCDEBUG(this->name()) << "forwarding interrupt " << irq << " by MSI";
+            regs->r_pending[reg_idx] &= ~(0x1 << bit_ofs);
+            msi_queue.push_back(regs->r_targetcfg[irq - 1]);
+            msi_queued.notify(sc_core::SC_ZERO_TIME);
+        }
+    }
+}
+
+void aplic::msi_thread() {
+    while(true) {
+        if(msi_queue.empty()) {
+            wait(msi_queued);
+        }
+        while(!msi_queue.empty()) {
+            auto target = msi_queue.front();
+            msi_queue.pop_front();
+            send_msi(target);
+        }
+    }
+}
+
+// the address for a hart is built from mmsiaddrcfg and mmsiaddrcfgh:
+//   g = (hart index >> LHXW) & (2^HHXW - 1)
+//   h = hart index & (2^LHXW - 1)
+//   address = (base PPN | (g << (HHXS + 12)) | (h << LHXS)) << 12
+void aplic::send_msi(uint32_t target) {
+    uint64_t hart_index = target >> TARGET_HART_INDEX_SHIFT;
+    uint32_t eiid = target & TARGET_EIID_MASK;
+    uint64_t base_ppn = (static_cast<uint64_t>(regs->r_mmsiaddrcfgh.highbaseppn) << 32) | regs->r_mmsiaddrcfg;
+    uint64_t g = (hart_index >> regs->r_mmsiaddrcfgh.lhxw) & ((1ULL << regs->r_mmsiaddrcfgh.hhxw) - 1);
+    uint64_t h = hart_index & ((1ULL << regs->r_mmsiaddrcfgh.lhxw) - 1);
+    uint64_t address = (base_ppn | (g << (regs->r_mmsiaddrcfgh.hhxs + 12)) | (h << regs->r_mmsiaddrcfgh.lhxs)) << 12;
+
+    // the interrupt identity, little-endian
+    std::array<uint8_t, 4> data{static_cast<uint8_t>(eiid), static_cast<uint8_t>(eiid >> 8), 0, 0};
+    tlm::tlm_generic_payload gp;
+    gp.set_command(tlm::TLM_WRITE_COMMAND);
+    gp.set_address(address);
+    gp.set_data_ptr(data.data());
+    gp.set_data_length(data.size());
+    gp.set_streaming_width(data.size());
+    gp.set_response_status(tlm::TLM_INCOMPLETE_RESPONSE);
+    sc_core::sc_time delay{sc_core::SC_ZERO_TIME};
+    msi_o->b_transport(gp, delay);
+    if(gp.get_response_status() != tlm::TLM_OK_RESPONSE) {
+        SCCWARN(this->name()) << "the MSI for interrupt identity " << eiid << " was not taken at address 0x" << std::hex << address;
+    }
+    if(delay != sc_core::SC_ZERO_TIME) {
+        wait(delay);
+    }
+}
