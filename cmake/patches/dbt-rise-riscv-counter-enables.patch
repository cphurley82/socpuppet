+    // cycle, time, instret and the hpmcounters (0xc00 to 0xc1f, and their upper halves at 0xc80 on RV32) may be read below M mode
+    // only if mcounteren has the counter's bit, and in U mode only if scounteren has it as well
+    bool counter_readable(unsigned addr) {
+        if(this->reg.PRIV == PRIV_M || (addr & ~0x9fu) != 0xc00)
+            return true;
+        const reg_t bit = reg_t(1) << (addr & 0x1f);
+        if(!(this->csr[mcounteren] & bit))
+            return false;
+        return this->reg.PRIV == PRIV_S || (this->csr[scounteren] & bit);
+    }
