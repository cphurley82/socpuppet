@@ -764,6 +764,9 @@ template <typename BASE, features_e FEAT> uint64_t riscv_hart_msu_vp<BASE, FEAT>
     // reset trap this->state
     this->reg.PRIV = new_priv;
     this->reg.trap_state = 0;
