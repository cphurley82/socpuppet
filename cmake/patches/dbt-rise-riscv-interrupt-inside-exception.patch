diff --git a/src/iss/arch/riscv_hart_m_p.h b/src/iss/arch/riscv_hart_m_p.h
index d59fba4..31a6382 100644
--- a/src/iss/arch/riscv_hart_m_p.h
+++ b/src/iss/arch/riscv_hart_m_p.h
@@ -509,6 +509,9 @@ template <typename BASE, features_e FEAT> uint64_t riscv_hart_m_p<BASE, FEAT>::e
     // reset trap state
     this->reg.PRIV = new_priv;
     this->reg.trap_state = 0;
+    // what is pending is worked out again for the enables the hart now has: an interrupt that was pending when an exception was
+    // taken must not be taken inside the exception's handler, where it is masked
+    check_interrupt();
     return this->reg.NEXT_PC;
 }
 
diff --git a/src/iss/arch/riscv_hart_msu_vp.h b/src/iss/arch/riscv_hart_msu_vp.h
