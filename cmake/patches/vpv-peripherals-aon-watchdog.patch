 void aon::reset_internal_cb() {}
 
+// The watchdog as it is out of reset: off, at zero, locked, with nothing to wait for. A register's reset goes
+// through its write callback, so resetting wdogcfg uses up a key that had been given and not yet used.
+void aon::wdog_reset() {
+    wdog_match_evt.cancel();
+    regs->wdogcfg.reset();
+    regs->wdogcmp.reset();
+    wdog_set_count(0);
+}
+
+bool aon::wdog_write_allowed() {
+    const bool allowed = wdog_unlocked;
+    wdog_unlocked = false;
+    return allowed;
+}
+
+// The core is always awake here, so the two ways of enabling come to the same.
+bool aon::wdog_counting() const { return (regs->r_wdogcfg & (WDOGCFG_ENALWAYS | WDOGCFG_ENCOREAWAKE)) != 0; }
+
+uint64_t aon::wdog_count_now() const {
+    if(!wdog_counting())
+        return wdog_count;
+    return wdog_count + static_cast<uint64_t>((sc_core::sc_time_stamp() - wdog_count_at) / lfclk);
+}
+
+void aon::wdog_set_count(uint64_t count) {
+    wdog_count = count;
+    wdog_count_at = sc_core::sc_time_stamp();
+}
+
+// Has wdog_match_cb run when the scaled count next reaches the compare value: at once if it already has, and no
+// sooner than at_least_ticks from where the count was last settled.
+void aon::wdog_schedule(uint64_t at_least_ticks) {
+    wdog_match_evt.cancel();
+    if(!wdog_counting())
+        return;
+    const uint64_t match = static_cast<uint64_t>(regs->r_wdogcmp) << (regs->r_wdogcfg & WDOGCFG_SCALE);
+    const uint64_t ticks = std::max(match > wdog_count ? match - wdog_count : 0, at_least_ticks);
+    const sc_core::sc_time when = wdog_count_at + lfclk * static_cast<double>(ticks);
+    const sc_core::sc_time now = sc_core::sc_time_stamp();
+    wdog_match_evt.notify(when > now ? when - now : sc_core::SC_ZERO_TIME);
+}
+
+void aon::wdog_match_cb() {
+    if((regs->r_wdogcfg & WDOGCFG_RSTEN) != 0) {
+        // A bite resets the watchdog with what it resets, for one tick of the low-frequency clock.
+        wdog_reset();
+        wdog_rst = true;
+        wdog_rst_done_evt.notify(lfclk);
+    } else {
+        regs->r_wdogcfg |= WDOGCFG_IP0;
+        if((regs->r_wdogcfg & WDOGCFG_ZEROCMP) != 0) {
+            // A tick at the least, so that a compare value of zero runs out once a tick and not for ever in none.
+            wdog_set_count(0);
+            wdog_schedule(1);
+        }
+    }
+    wdog_drive_evt.notify(sc_core::SC_ZERO_TIME);
+}
+
+void aon::wdog_rst_done_cb() {
+    wdog_rst = false;
+    wdog_drive_evt.notify(sc_core::SC_ZERO_TIME);
+}
+
+void aon::wdog_drive_cb() {
+    rst_o = ext_rst || wdog_rst;
+    if(wdog_irq_o.get_interface())
+        wdog_irq_o = (regs->r_wdogcfg & WDOGCFG_IP0) != 0;
+}
+
 } /* namespace sifive */
 } /* namespace vpvper */
