+const uint32_t WDOGCFG_ENCOREAWAKE = 1u << 13;
+const uint32_t WDOGCFG_IP0 = 1u << 28;
+// What is compared is 16 bits wide.
+const uint32_t WDOGCMP_MASK = 0xffff;
+// What unlocks the watchdog's registers for one write, and what feeds it.
+const uint32_t WDOGKEY = 0x51f15e;
+const uint32_t WDOGFEED = 0xd09f00d;
+} // namespace
 
