diff --git a/target/riscv/insn_trans/trans_rvi.c.inc b/target/riscv/insn_trans/trans_rvi.c.inc
index 54b9b4f..cf47caf 100644
--- a/target/riscv/insn_trans/trans_rvi.c.inc
+++ b/target/riscv/insn_trans/trans_rvi.c.inc
@@ -958,10 +958,13 @@ static bool trans_fence_i(DisasContext *ctx, arg_fence_i *a)
     }
 
     /*
-     * FENCE_I is a no-op in QEMU,
-     * however we need to end the translation block
+     * What the CPU itself writes QEMU sees, and invalidates what it had
+     * translated from there. What a device writes it does not, when guest
+     * RAM is shared with a platform outside QEMU, so forget it all here,
+     * and end the translation block.
      */
     gen_update_pc(ctx, ctx->cur_insn_len);
+    gen_helper_fence_i(tcg_env);
     exit_tb(ctx);
     ctx->base.is_jmp = DISAS_NORETURN;
     return true;
