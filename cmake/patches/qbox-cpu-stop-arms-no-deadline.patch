@@ -705,6 +705,8 @@ public:
     bool loop_is_busy();
 
     bool can_run();
+    /* Whether a run of it runs no instruction: it is stopped, or has a stop to take. */
+    bool is_stopped();
 
     void set_soft_stopped(bool stopped);
     void halt(bool halted);
