diff --git a/qemu-components/common/include/cpu.h b/qemu-components/common/include/cpu.h
index 7d76f644..07fb8a47 100644
--- a/qemu-components/common/include/cpu.h
+++ b/qemu-components/common/include/cpu.h
@@ -557,8 +557,16 @@ protected:
              * main loop warps the virtual clock to (icount with sleep off),
              * kicking the CPU every quantum. Both are done holding the BQL,
              * which the CPU loop is entered and left with.
+             *
+             * And not for a run that only takes a stop, the platform's halt
+             * or a debugger's stop of the machine: the CPU runs nothing, and
+             * a deadline armed meanwhile is one QEMU's main loop can warp
+             * the clock to while the CPU stands stopped, a quantum on. The
+             * sync after the run then waits for SystemC's time to catch up,
+             * which a platform holding its clock for the debugger never lets
+             * it do, and the CPU never looks again.
              */
-            rearm_deadline_timer();
+            if (!m_cpu.is_stopped()) rearm_deadline_timer();
             run_cpu_loop();
             m_deadline_timer->del();
             sync_with_kernel();
