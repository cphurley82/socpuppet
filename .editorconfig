# Editor settings that match what the linters enforce (tools/lint.py), so a
# file starts out right. See https://editorconfig.org.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{h,cpp}]
max_line_length = 80

[*.{py,pyi}]
indent_size = 4
max_line_length = 80

[*.toml]
indent_size = 4

[*.md]
# One paragraph per line, however long: the editor wraps it for display.
max_line_length = off
