# clang-tidy's checks for our C++. Run them with the build's `tidy` target:
#   uv run cmake --build --preset dev --target tidy
Checks:
  - bugprone-*
  - clang-analyzer-*
  - google-*
  - modernize-*
  - performance-*
  - portability-*
  - readability-*

  # Switched off, each for a reason:

  # Any two parameters of one type "could be swapped". True of most functions
  # that take an address and a value.
  - -bugprone-easily-swappable-parameters
  # `auto f() -> int` everywhere is not Google style.
  - -modernize-use-trailing-return-type
  # [[nodiscard]] on every getter is noise.
  - -modernize-use-nodiscard
  # Asks for a one-byte base type on every small enum.
  - -performance-enum-size
  # Google style allows `if (done) return;` on one line with no braces. The
  # google- version of this check allows it too, and stays on.
  - -readability-braces-around-statements
  # Short names such as `it` and `id` are fine.
  - -readability-identifier-length
  # Addresses, sizes and test data are numbers; naming each one would bury
  # the code.
  - -readability-magic-numbers

# Every finding fails the run. A check that is not worth failing for is not
# worth having on.
WarningsAsErrors: '*'

CheckOptions:
  # Google's names. Types and functions are CamelCase, variables are
  # lower_case, a private member ends in an underscore, and a constant is a
  # k followed by CamelCase.
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.FunctionCase: CamelCase
  # Names we do not get to choose. TLM-2.0 calls a target's transport
  # functions by these names, and anyone who has met TLM elsewhere knows them.
  readability-identifier-naming.FunctionIgnoredRegexp: '^(b_transport|nb_transport_fw|nb_transport_bw|transport_dbg|get_direct_mem_ptr|invalidate_direct_mem_ptr)$'
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ProtectedMemberSuffix: _
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: k
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: k
