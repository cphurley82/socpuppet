{
  "name": "socpuppet",
  "build": { "dockerfile": "Dockerfile" },
  // The repository at /workspace, and the container's own trees kept apart
  // from the host's in Docker volumes, as tools/devcontainer.py has them on
  // a Mac, which says why. Their mount points are made first, on the host:
  // Docker makes a missing one, and on Linux makes it root's.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "initializeCommand": "mkdir -p build/qbox build/qbox-dev build/firmware/linux-aarch64 build/firmware/linux-x86_64",
  "mounts": [
    "source=socpuppet-qbox,target=/workspace/build/qbox,type=volume",
    "source=socpuppet-qbox-dev,target=/workspace/build/qbox-dev,type=volume",
    // Linux's firmware tools, in build/firmware/linux-<processor>: this file
    // cannot ask which processor it is on, so both are mounted.
    "source=socpuppet-firmware-linux,target=/workspace/build/firmware/linux-aarch64,type=volume",
    "source=socpuppet-firmware-linux,target=/workspace/build/firmware/linux-x86_64,type=volume"
  ],
  "postCreateCommand": "uv sync",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cmake-tools", "ms-vscode.cpptools", "ms-python.python"]
    }
  }
}
