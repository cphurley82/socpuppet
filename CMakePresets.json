{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development build with tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SOCPUPPET_DEVELOPER_MODE": "ON",
        "SOCPUPPET_COVERAGE": "OFF",
        "SOCPUPPET_SANITIZE": "OFF"
      }
    },
    {
      "name": "coverage",
      "displayName": "Development build that measures test coverage",
      "inherits": "dev",
      "cacheVariables": {
        "SOCPUPPET_COVERAGE": "ON",
        "SOCPUPPET_COVERAGE_CPP_FLOOR": "90",
        "SOCPUPPET_COVERAGE_PYTHON_FLOOR": "95"
      }
    },
    {
      "name": "asan",
      "displayName": "Development build with sanitizers in the C++ tests",
      "inherits": "dev",
      "cacheVariables": {
        "SOCPUPPET_SANITIZE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "asan", "configurePreset": "asan" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "cpp" } }
    }
  ]
}
