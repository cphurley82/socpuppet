{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development build with tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SOCPUPPET_DEVELOPER_MODE": "ON",
        "SOCPUPPET_COVERAGE": "OFF",
        "SOCPUPPET_SANITIZE": "OFF",
        "SOCPUPPET_BUILD_SPIKES": "OFF"
      }
    },
    {
      "name": "coverage",
      "displayName": "Development build that measures test coverage",
      "inherits": "dev",
      "cacheVariables": {
        "SOCPUPPET_COVERAGE": "ON",
        "SOCPUPPET_COVERAGE_CPP_FLOOR": "90",
        "SOCPUPPET_COVERAGE_PYTHON_FLOOR": "95"
      }
    },
    {
      "name": "asan",
      "displayName": "Development build with sanitizers in the C++ tests",
      "inherits": "dev",
      "cacheVariables": {
        "SOCPUPPET_SANITIZE": "ON"
      }
    },
    {
      "name": "spike",
      "displayName": "Development build plus the exploratory code under spikes/",
      "inherits": "dev",
      "cacheVariables": {
        "SOCPUPPET_BUILD_SPIKES": "ON"
      }
    },
    {
      "name": "linux",
      "displayName": "Development build in the devcontainer's image, from tools/devcontainer.py",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/linux"
    },
    {
      "name": "qbox",
      "displayName": "Development build with QBox's CPU, from tools/build_qbox.py",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/qbox-dev",
      "cacheVariables": {
        "SOCPUPPET_QBOX_DIR": "${sourceDir}/build/qbox/install"
      }
    },
    {
      "name": "pciem",
      "displayName": "Development build with a real host, from tools/build_pciem.py",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/pciem-dev",
      "cacheVariables": {
        "SOCPUPPET_PCIEM_DIR": "${sourceDir}/build/pciem"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "spike", "configurePreset": "spike" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "qbox", "configurePreset": "qbox" },
    { "name": "pciem", "configurePreset": "pciem" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "qbox" } },
      "execution": { "jobs": 8 }
    },
    {
      "name": "fast",
      "inherits": "dev",
      "filter": { "include": { "label": "^(cpp|python)$" } }
    },
    {
      "name": "quick",
      "inherits": "dev",
      "filter": { "exclude": { "label": "long|qbox" } }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "cpp" } },
      "execution": { "jobs": 8 }
    },
    {
      "name": "spike",
      "configurePreset": "spike",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "spike" } }
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 8 }
    },
    {
      "name": "qbox",
      "configurePreset": "qbox",
      "output": { "outputOnFailure": true },
      "environment": { "SOCPUPPET_CPU": "qbox_cpu" },
      "filter": { "exclude": { "label": "interpreter" } },
      "execution": { "jobs": 8 }
    },
    {
      "name": "qbox-quick",
      "inherits": "qbox",
      "filter": { "include": { "label": "^(cpp|python|boots)$" } }
    },
    {
      "name": "pciem",
      "configurePreset": "pciem",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 8 }
    },
    {
      "name": "speed",
      "configurePreset": "spike",
      "output": { "verbosity": "verbose" },
      "filter": { "include": { "label": "speed" } },
      "execution": { "jobs": 1 }
    }
  ]
}
