# What every socpuppet SoC is: a RISC-V core with the privileged
# architecture (machine mode, its timer and its interrupts). One whose
# devicetree has a PLIC has that as its interrupt controller, and one
# whose devicetree has an IMSIC has Zephyr's driver for that switched on
# by the devicetree alone.
config SOC_FAMILY_SOCPUPPET
	select INCLUDE_RESET_VECTOR
	select RISCV
	select RISCV_PRIVILEGED
	select RISCV_HAS_PLIC if DT_HAS_SIFIVE_PLIC_1_0_0_ENABLED
	select RISCV_SOC_HAS_GP_RELATIVE_ADDRESSING
