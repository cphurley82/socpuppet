/dts-v1/;

/ {
	#address-cells = <2>;
	#size-cells = <2>;

	chosen {
		zephyr,console = &io_uart;
		zephyr,shell-uart = &io_uart;
		zephyr,sram = &compute_ram;
	};

	aliases {
		led0 = &io_gpio_led0;
		rtc = &io_rtc;
		watchdog0 = &compute_wdt;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <10000000>;

		compute_cpu: cpu@0 {
			device_type = "cpu";
			compatible = "riscv";
			reg = <0>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "zicsr", "zifencei", "smcsrind", "ssaia";
			mmu-type = "riscv,sv39";

			compute_cpu_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#address-cells = <0>;
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};
	};

	io_boot_flash_clock: io_boot_flash_clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <50000000>;
	};

	io_gpio_leds: io_gpio_leds {
		compatible = "gpio-leds";
		io_gpio_led0: led_0 {
			gpios = <&io_gpio 2 0>;
		};
	};

	compute_ram: memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x4000000>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		compute_syscon: syscon@100000 {
			compatible = "socpuppet,system-controller", "syscon";
			reg = <0x0 0x100000 0x0 0x20>;
		};

		compute_wdt: watchdog@101000 {
			compatible = "sifive,wdt";
			reg = <0x0 0x101000 0x0 0x1000>;
			interrupt-parent = <&compute_aplic>;
			interrupts = <17 1 4>;
		};

		compute_timer: timer@200bff8 {
			compatible = "riscv,machine-timer";
			reg = <0x0 0x200bff8 0x0 0x8>, <0x0 0x2004000 0x0 0x8>;
			reg-names = "mtime", "mtimecmp";
			interrupts-extended = <&compute_cpu_intc 7>;
		};

		compute_aplic: interrupt-controller@c000000 {
			compatible = "riscv,aplic";
			reg = <0x0 0xc000000 0x0 0x8000>;
			#address-cells = <0>;
			#interrupt-cells = <3>;
			interrupt-controller;
			riscv,num-sources = <31>;
			msi-parent = <&compute_imsic>;
		};

		io_uart: uart@10000000 {
			compatible = "ns16550";
			reg = <0x0 0x10000000 0x0 0x8>;
			reg-shift = <0>;
			clock-frequency = <3686400>;
			interrupt-parent = <&io_aplic>;
			interrupts = <16 1 4>;
		};

		io_aplic: interrupt-controller@100c0000 {
			compatible = "riscv,aplic";
			reg = <0x0 0x100c0000 0x0 0x8000>;
			#address-cells = <0>;
			#interrupt-cells = <3>;
			interrupt-controller;
			riscv,num-sources = <31>;
			msi-parent = <&compute_imsic>;
		};

		io_boot_flash: spi@100d0000 {
			compatible = "sifive,spi0";
			reg = <0x0 0x100d0000 0x0 0x1000>, <0x0 0x10200000 0x0 0x1000000>;
			reg-names = "control", "mem";
			clocks = <&io_boot_flash_clock>;
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts-extended = <&io_aplic 29 1 4>;
			io_boot_flash_chip: flash@0 {
				compatible = "jedec,spi-nor";
				reg = <0>;
				jedec-id = [ef 40 18];
				size = <0x8000000>;
				spi-max-frequency = <25000000>;
			};
		};

		io_gpio: gpio@100f0000 {
			compatible = "sifive,gpio0";
			reg = <0x0 0x100f0000 0x0 0x1000>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <4>;
			interrupt-parent = <&io_aplic>;
			interrupts = <25 1 4 26 1 4 27 1 4 28 1 4>;
		};

		io_i2c: i2c@100f1000 {
			compatible = "sifive,i2c0";
			reg = <0x0 0x100f1000 0x0 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <100000>;
			interrupts-extended = <&io_aplic 30 1 4>;
		};

		io_rtc: rtc@100f2000 {
			compatible = "google,goldfish-rtc";
			reg = <0x0 0x100f2000 0x0 0x1000>;
			interrupts-extended = <&io_aplic 31 1 4>;
		};

		compute_imsic: interrupt-controller@24000000 {
			compatible = "riscv,imsic";
			reg = <0x0 0x24000000 0x0 0x1000>;
			#address-cells = <0>;
			#interrupt-cells = <1>;
			interrupt-controller;
			msi-controller;
			riscv,num-ids = <63>;
			riscv,hart-id = <0>;
			interrupts-extended = <&compute_cpu_intc 11>;
		};
	};
};
