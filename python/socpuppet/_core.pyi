"""The simulator: the C++ extension module, as Python sees it.

The module itself is built from src/socpuppet/bindings/core.cpp. This file
describes it to type checkers, which cannot read a compiled extension.
"""

from collections.abc import Callable

from socpuppet.components import Script
from socpuppet.i2c import I2cDevice
from socpuppet.spi import SpiDevice

def implementations() -> list[str]: ...

has_qbox: bool
has_pciem: bool

def global_quantum_in_picoseconds() -> int: ...

# (word size in bits, entry point, [(physical address, bytes), ...])
def read_elf(path: str) -> tuple[int, int, list[tuple[int, bytes]]]: ...

class Platform:
    def __init__(self, color_log: bool) -> None: ...
    def add(
        self, path: str, implementation: str, config: dict[str, int]
    ) -> None: ...
    def bind(self, source: str, sink: str, traced: bool) -> None: ...
    # Each record is (time in ps, source, sink, is_write, address, data, ok).
    def trace_records(
        self,
    ) -> list[tuple[int, str, str, bool, int, bytes, bool]]: ...
    def set_script(self, path: str, generator_function: Script) -> None: ...
    def spi_flash_attach(
        self, path: str, chip_select: int, device: SpiDevice
    ) -> None: ...
    def i2c_controller_attach(
        self, path: str, address: int, device: I2cDevice
    ) -> None: ...
    def gpio_level(self, path: str, pin: int) -> bool | None: ...
    def gpio_drive(self, path: str, pin: int, level: bool | None) -> None: ...
    def gpio_on_change(
        self, path: str, listener: Callable[[int, bool | None], object]
    ) -> None: ...
    def far_end_output(self, path: str, since: int) -> bytes: ...
    def far_end_write(self, path: str, received: bytes) -> None: ...
    def disk_load(self, path: str, image: bytes) -> None: ...
    def disk_contents(self, path: str) -> bytes: ...
    def nand_load(self, path: str, image: bytes) -> None: ...
    def nand_contents(self, path: str) -> bytes: ...
    def pciem_host_start(self, path: str) -> None: ...
    def pciem_host_event_fd(self, path: str) -> int: ...
    def pciem_host_service(self, path: str) -> None: ...
    def pciem_host_refresh(self, path: str) -> None: ...
    def net_send(self, path: str, frame: bytes) -> None: ...
    def net_received(self, path: str, since: int) -> list[bytes]: ...
    def net_dropped(self, path: str) -> int: ...
    def virtio_fs_serve(
        self, path: str, tag: str, answer: Callable[[bytes], bytes]
    ) -> None: ...
    def virtio_9p_serve(
        self, path: str, tag: str, answer: Callable[[bytes], bytes]
    ) -> None: ...
    def ports(self, path: str) -> list[str]: ...
    def elaborate(self) -> None: ...
    def run(self) -> None: ...
    def set_quantum(self, picoseconds: int) -> None: ...
    def run_for(self, picoseconds: int) -> None: ...
    def step(self) -> bool: ...
    def picoseconds_to_next_activity(self) -> int | None: ...
    def time_in_picoseconds(self) -> int: ...
    def debug_read(
        self, via: str, address: int, length: int
    ) -> bytes | None: ...
    def debug_write(self, via: str, address: int, data: bytes) -> bool: ...
