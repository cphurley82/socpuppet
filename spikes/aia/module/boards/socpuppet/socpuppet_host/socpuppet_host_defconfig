# The console prints through the UART.
CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
# The image is loaded into RAM and runs from there. Nothing executes in
# place from a flash.
CONFIG_XIP=n
# The UART interrupts when a byte has come in, which is what a shell waits
# for. Without this the shell asks the UART every 10 ms instead.
CONFIG_UART_INTERRUPT_DRIVEN=y
