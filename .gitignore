# What a checkout makes and keeps out of git.

# Every build tree: the presets', the firmware's, QBox's, CI's runs.
build/

# The extension a build copies next to the package, and a wheel's.
*.so
dist/
wheelhouse/
*.egg-info/

# Python's caches, and its tools'.
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*

# The capture examples/linux_cable.py leaves behind.
*.pcap
